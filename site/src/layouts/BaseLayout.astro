---
import "../styles/global.css";
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/dm-sans/300.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "肖傲，西北师范大学数学与应用数学本科生。关注非线性微分方程、边值问题与复分析。"
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://xiaoao2math-droid.github.io/" />
    <meta name="keywords" content="肖傲,Xiao Ao,Ao Xiao,西北师范大学,数学,非线性分析,复分析" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content="肖傲 Xiao Ao · 个人学术主页" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://xiaoao2math-droid.github.io/" />
    <meta property="og:image" content="https://xiaoao2math-droid.github.io/og.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot />
    <script is:inline>
      const root = document.documentElement;
      let preferred = 'zh';
      try { preferred = localStorage.getItem('site-language') || 'zh'; } catch {}
      const shell = document.querySelector(".shell");
      const main = document.querySelector("[data-scroll-main]");
      const siteHeader = document.querySelector(".site-header");
      const sidebar = document.querySelector("[data-profile-sidebar]");
      const sidebarClose = document.querySelector("[data-sidebar-close]");
      const sidebarBackdrop = document.querySelector("[data-sidebar-backdrop]");
      const homeTrigger = document.querySelector("[data-home-trigger]");
      const sectionTrigger = document.querySelector("[data-section-trigger]");
      const sectionMenu = document.querySelector("[data-section-menu]");
      const sectionCurrent = document.querySelector("[data-section-current]");
      let wechatTrigger = document.querySelector("[data-wechat-trigger]");
      const wechatModal = document.querySelector("[data-wechat-modal]");
      const wechatClose = document.querySelector("[data-wechat-close]");
      const wechatBackdrop = document.querySelector("[data-wechat-backdrop]");
      const sections = Array.from(document.querySelectorAll(".sec[id]"));
      const links = Array.from(document.querySelectorAll("[data-section-link][href^='#']"));
      const narrowScreen = window.matchMedia("(max-width: 860px)");
      let currentSection = sections[0]?.id || "about";

      const updateSectionLabel = () => {
        const activeLink = document.querySelector(`.section-menu-link[href="#${currentSection}"]`);
        if (!activeLink || !sectionCurrent) return;
        const language = root.dataset.lang === "zh" ? "zh" : "en";
        sectionCurrent.textContent = activeLink.dataset[language === "zh" ? "labelZh" : "labelEn"];
      };

      const setLanguage = (language) => {
        const next = language === "zh" ? "zh" : "en";
        root.dataset.lang = next;
        root.lang = next === "zh" ? "zh-CN" : "en";
        try { localStorage.setItem("site-language", next); } catch {}
        document.querySelectorAll("[data-language-button]").forEach((button) => {
          const active = button.dataset.languageButton === next;
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-pressed", active ? "true" : "false");
        });
        updateSectionLabel();
      };

      setLanguage(preferred);

      const closeSectionMenu = ({ restoreFocus = false } = {}) => {
        if (!sectionTrigger || !sectionMenu) return;
        sectionTrigger.setAttribute("aria-expanded", "false");
        sectionTrigger.classList.remove("is-open");
        sectionMenu.hidden = true;
        if (restoreFocus) sectionTrigger.focus();
      };

      const openSectionMenu = () => {
        if (!sectionTrigger || !sectionMenu || !narrowScreen.matches) return;
        sectionTrigger.setAttribute("aria-expanded", "true");
        sectionTrigger.classList.add("is-open");
        sectionMenu.hidden = false;
      };

      const closeSidebar = ({ restoreFocus = false } = {}) => {
        root.classList.remove("sidebar-open");
        homeTrigger?.setAttribute("aria-expanded", "false");
        if (sidebarBackdrop) sidebarBackdrop.hidden = true;
        if (main) main.inert = false;
        if (siteHeader) siteHeader.inert = false;
        if (narrowScreen.matches) {
          sidebar?.setAttribute("aria-hidden", "true");
          if (sidebar) sidebar.inert = true;
        } else {
          sidebar?.removeAttribute("aria-hidden");
          if (sidebar) sidebar.inert = false;
        }
        if (restoreFocus) homeTrigger?.focus();
      };

      const openSidebar = () => {
        if (!narrowScreen.matches) return;
        closeSectionMenu();
        root.classList.add("sidebar-open");
        homeTrigger?.setAttribute("aria-expanded", "true");
        sidebar?.setAttribute("aria-hidden", "false");
        if (sidebar) sidebar.inert = false;
        if (main) main.inert = true;
        if (siteHeader) siteHeader.inert = true;
        if (sidebarBackdrop) sidebarBackdrop.hidden = false;
        sidebarClose?.focus();
      };

      const closeWechat = ({ restoreFocus = false } = {}) => {
        if (!wechatModal) return;
        root.classList.remove("wechat-open");
        wechatModal.hidden = true;
        wechatTrigger?.setAttribute("aria-expanded", "false");
        if (siteHeader) siteHeader.inert = false;
        if (shell) shell.inert = false;
        if (restoreFocus) wechatTrigger?.focus();
      };

      const openWechat = () => {
        if (!wechatModal) return;
        closeSectionMenu();
        closeSidebar();
        root.classList.add("wechat-open");
        wechatModal.hidden = false;
        wechatTrigger?.setAttribute("aria-expanded", "true");
        if (siteHeader) siteHeader.inert = true;
        if (shell) shell.inert = true;
        wechatClose?.focus();
      };

      homeTrigger?.addEventListener("click", () => {
        if (narrowScreen.matches) {
          if (root.classList.contains("sidebar-open")) closeSidebar({ restoreFocus: true });
          else openSidebar();
          return;
        }
        sidebar?.scrollTo({ top: 0, behavior: "smooth" });
        main?.scrollTo({ top: 0, behavior: "smooth" });
        window.history.replaceState(null, "", "#about");
      });

      sidebarClose?.addEventListener("click", () => closeSidebar({ restoreFocus: true }));
      sidebarBackdrop?.addEventListener("click", () => closeSidebar({ restoreFocus: true }));
      document.querySelectorAll('[data-wechat-trigger]').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          wechatTrigger = trigger;
          const image = wechatModal?.querySelector('img');
          const title = wechatModal?.querySelector('h2');
          if (image) {
            image.src = trigger.dataset.qrSrc || '/wechat-aoaomath.jpg';
            image.alt = trigger.dataset.qrTitle || '微信公众号 · 傲傲数学';
          }
          if (title) title.textContent = trigger.dataset.qrTitle || '微信公众号 · 傲傲数学';
          openWechat();
        });
      });
      wechatClose?.addEventListener("click", () => closeWechat({ restoreFocus: true }));
      wechatBackdrop?.addEventListener("click", () => closeWechat({ restoreFocus: true }));

      sectionTrigger?.addEventListener("click", (event) => {
        event.stopPropagation();
        if (sectionTrigger.getAttribute("aria-expanded") === "true") closeSectionMenu({ restoreFocus: true });
        else openSectionMenu();
      });

      document.addEventListener("click", (event) => {
        const languageButton = event.target.closest("[data-language-button]");
        if (languageButton) setLanguage(languageButton.dataset.languageButton);
        if (sectionMenu && sectionTrigger && !sectionMenu.contains(event.target) && !sectionTrigger.contains(event.target)) {
          closeSectionMenu();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          if (root.classList.contains("wechat-open")) closeWechat({ restoreFocus: true });
          else if (root.classList.contains("sidebar-open")) closeSidebar({ restoreFocus: true });
          else if (sectionTrigger?.getAttribute("aria-expanded") === "true") closeSectionMenu({ restoreFocus: true });
          return;
        }
        if (event.key === "Tab" && root.classList.contains("wechat-open") && wechatModal) {
          const focusable = Array.from(wechatModal.querySelectorAll('button:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])'));
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last?.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first?.focus();
          }
          return;
        }
        if (event.key === "Tab" && root.classList.contains("sidebar-open") && sidebar) {
          const focusable = Array.from(sidebar.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'));
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last?.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first?.focus();
          }
        }
      });

      if (main && sections.length && links.length) {
        const setActiveSection = () => {
          const top = main.scrollTop + 112;
          let current = sections[0].id;
          sections.forEach((section) => {
            if (section.offsetTop <= top) current = section.id;
          });
          if (main.scrollTop + main.clientHeight >= main.scrollHeight - 2) {
            current = sections[sections.length - 1].id;
          }
          currentSection = current;
          links.forEach((link) => {
            const active = link.getAttribute("href") === `#${current}`;
            link.classList.toggle("active", active);
            if (link.classList.contains("section-menu-link")) {
              if (active) link.setAttribute("aria-current", "location");
              else link.removeAttribute("aria-current");
            }
          });
          updateSectionLabel();
        };

        main.addEventListener("scroll", setActiveSection, { passive: true });
        window.addEventListener("resize", setActiveSection);
        links.forEach((link) => {
          link.addEventListener("click", (event) => {
            const target = document.querySelector(link.getAttribute("href"));
            if (!target) return;
            event.preventDefault();
            closeSectionMenu({ restoreFocus: link.classList.contains("section-menu-link") });
            closeSidebar();
            target.scrollIntoView({ behavior: "smooth", block: "start" });
            window.history.replaceState(null, "", link.getAttribute("href"));
            currentSection = target.id;
            links.forEach((sectionLink) => {
              const active = sectionLink.getAttribute("href") === `#${currentSection}`;
              sectionLink.classList.toggle("active", active);
              if (sectionLink.classList.contains("section-menu-link")) {
                if (active) sectionLink.setAttribute("aria-current", "location");
                else sectionLink.removeAttribute("aria-current");
              }
            });
            updateSectionLabel();
          });
        });
        setActiveSection();
      }

      const syncResponsiveState = () => {
        closeSectionMenu();
        closeSidebar();
      };

      narrowScreen.addEventListener("change", syncResponsiveState);
      syncResponsiveState();
    </script>
  </body>
</html>
